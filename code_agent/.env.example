# Optional service settings
CODE_AGENT_DB_PATH=./code_agent.db
CODE_AGENT_WORKSPACE_ROOT=./workspaces
CODE_AGENT_DOCKER_IMAGE=python:3.11-slim
CODE_AGENT_APPROVAL_TTL_SECONDS=300
CODE_AGENT_SSE_HEARTBEAT_SECONDS=15
