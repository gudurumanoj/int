# Paths are resolved from the process working directory.
ORCH_SQLITE_PATH=./orchestrator.db
ORCH_MODEL_REGISTRY_PATH=./models.json

ORCH_IDEMPOTENCY_TTL_SECONDS=86400
ORCH_EVENT_RETENTION_SECONDS=3600
ORCH_DEFAULT_TIMEOUT_MS=5000
ORCH_DEFAULT_RETRIES=1
ORCH_DEFAULT_MAX_TOKENS=512
ORCH_DEFAULT_TEMPERATURE=0.2
ORCH_DEFAULT_API_KEY_ENV=OPENAI_API_KEY

# Each models.json entry names its own environment variable. Never put keys
# in models.json. These values are intentionally blank placeholders.
MODEL_FAST_API_KEY=
MODEL_BALANCED_API_KEY=
MODEL_QUALITY_API_KEY=
