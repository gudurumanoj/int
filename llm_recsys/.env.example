# The demo stays deterministic when OPENAI_API_KEY is empty.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=2.0
OPENAI_MAX_RETRIES=0
OPENAI_TEMPERATURE=0.0
OPENAI_MAX_TOKENS=700

DATABASE_PATH=./recsys.db
DEFAULT_TENANT_ID=demo
HMAC_SECRET=replace-with-a-long-random-secret

RECOMMENDATION_TTL_SECONDS=1800
IDEMPOTENCY_TTL_SECONDS=86400
LLM_SHORTLIST_SIZE=5
ELIGIBILITY_MAX_CANDIDATES=100
ELIGIBILITY_REQUIRE_AVAILABLE=true
# Optional comma-separated category allowlist. Empty means all categories.
ELIGIBILITY_ALLOWED_CATEGORIES=
